# Copiar a /etc/atlas/atlas.env (dueño atlas, permisos 600). NUNCA subir el archivo real al repo.
ATLAS_DATA_DIR=/var/lib/atlas
# Alertas (opcionales: sin ellas solo se registran en la tabla events)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_URL=
# Modo B (testnet). Solo la llave del AGENTE (API wallet), jamás la maestra.
HL_TESTNET_ACCOUNT=
HL_TESTNET_AGENT_KEY=
